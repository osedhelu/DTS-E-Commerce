# Copiar: cp docker-infrastructure/.env.example docker-infrastructure/.env
# Guía completa: docs/DEPLOY_DOCKER.md
# Instalación: make install-server  →  make backend-createsuperuser

# ── Django API ───────────────────────────────────────────────────────────────
SECRET_KEY=change-me-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api,extreme.local,192.168.0.194
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://extreme.local:8000
API_PORT=8000
# Acceso: http://extreme.local:8000/admin/  (con barra final)
# En otro PC, apunta extreme.local a la IP del servidor (/etc/hosts o DNS)
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# ── Base de datos ────────────────────────────────────────────────────────────
# Modo local (PostGIS en Docker — default):
USE_LOCAL_DB=true
DB_NAME=dts_delivery
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Modo externo (Railway, etc.): desactiva PostGIS local y usa URL remota
# USE_LOCAL_DB=false
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
#
# Railway — URL interna (*.railway.internal): solo si el stack Docker corre
# EN Railway (misma red privada). Desde tu Mac usa la URL pública TCP del
# servicio PostGIS (Connect → Public Network) en DATABASE_URL.
#
# DATABASE_URL=postgresql://postgres:PASSWORD@postgis.railway.internal:5432/ECOMMERCE_DIS

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
# REDIS_URL=redis://redis:6379/0   # default en Docker; override para Redis externo

# ── Mailpit (correo de desarrollo/staging) ───────────────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
DEFAULT_FROM_EMAIL=noreply@dts.local

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_LOG_LEVEL=info
CELERY_CONCURRENCY=2

# ── Medios (logos, fotos de producto) ────────────────────────────────────────
SERVE_MEDIA=True
MEDIA_PUBLIC_BASE_URL=http://extreme.local:8000
MEDIA_ROOT=/app/backend/media

# ── Firebase Cloud Messaging (opcional) ──────────────────────────────────────
# Coloca el JSON en docker-infrastructure/volumes/fcm/service-account.json
# FCM_CREDENTIALS_PATH=/secrets/fcm/service-account.json
# FCM_CREDENTIALS_HOST_PATH=./volumes/fcm
